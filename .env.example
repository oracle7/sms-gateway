# ==========================================
# SMS & MMS Gateway v3.0 - Environment Configuration
# ==========================================

# SQLite Database & Private Media Storage (NEVER inside static/)
DATABASE_URL=sqlite:///./data/sms_gateway_v3.db
MEDIA_DIR=./data/media

# Pixel 6 Android SMS Gateway Settings
SMS_API_URL=http://<PIXEL6_IP>:8080
SMS_API_LOGIN=<gateway_username>
SMS_API_PASS=<gateway_password>
SMS_DID=+19296141937

# Session & HIPAA Security Settings
SESSION_COOKIE_NAME=smsgw_session
# Set to false ONLY temporarily while finishing HTTPS certificates in Nginx
SESSION_COOKIE_SECURE=true
# Standardized overnight logout for all users (24h HH:MM in CLINIC_TIMEZONE)
CLINIC_TIMEZONE=America/New_York
SESSION_DAILY_CUTOFF_TIME=00:05
# Inactivity timeout in minutes (0 = disabled, rely on overnight cutoff + OS lock)
SESSION_IDLE_TIMEOUT_MINUTES=0
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
MIN_PASSWORD_LENGTH=12

# Trusted Reverse Proxy IPs (used to read real client IP from X-Forwarded-For)
TRUSTED_PROXY_IPS=127.0.0.1,::1

# Android Gateway Webhook Security
# Set WEBHOOK_VERIFY_SIGNATURE=true once Signing Key is configured in the Pixel 6 app
WEBHOOK_VERIFY_SIGNATURE=false
WEBHOOK_SIGNING_KEY=
# Optional comma-separated IP/CIDR allowlist for Pixel 6 (e.g. 192.168.1.50,10.8.0.0/24)
WEBHOOK_ALLOWED_IPS=
WEBHOOK_MAX_CLOCK_SKEW_SECONDS=300

# Maintenance & Real-Time Streaming
RAW_WEBHOOK_RETENTION_DAYS=30
SSE_HEARTBEAT_SECONDS=15
LOG_LEVEL=INFO
